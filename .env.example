# Where the API runs (no path, no trailing slash). This app forwards /api/v1/* there, so the
# browser talks to one origin. Local: http://localhost:4000   Production: https://<api>.onrender.com
API_PROXY_URL=http://localhost:4000

# Optional. Only for the custom-domain setup where the browser calls the API directly
# (https://api.example.com/api/v1). Leave unset to use the forwarding above.
# NEXT_PUBLIC_API_URL=
